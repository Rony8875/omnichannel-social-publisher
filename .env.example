# ==========================================
# Google BigQuery Cloud Database
# ==========================================
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=social_publisher
BIGQUERY_LOCATION=US

NEXT_PUBLIC_SUPABASE_URL=https://cpnovfierqgnmemipfbd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__nO6Yw3E6v_eSARAE-c4aA_1by-A4dV
# Option A: Path to Service Account JSON Key (Save inside credentials/ directory)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/bigquery-sa-key.json

# Option B: Or paste the full Service Account JSON string directly (Best for Railway/Render/Vercel)
# BIGQUERY_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ==========================================
# Public App Base URL (For OAuth Callbacks)
# ==========================================
# When deployed to Vercel/Render, set this to your live domain (e.g. https://my-app.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ==========================================
# WhatsApp Web Baileys Engine
# ==========================================
NEXT_PUBLIC_ENGINE_URL=http://localhost:5001

# ==========================================
# Buffer-Style Official OAuth 2.0 Credentials
# ==========================================

# 1. Meta / WhatsApp App Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# 2. Dedicated Instagram API Configuration (Independent of WhatsApp)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
INSTAGRAM_HANDLE=@yourhandle

# 2. LinkedIn (https://www.linkedin.com/developers/apps)
# Valid OAuth Redirect URI: ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 3. Twitter / X (https://developer.twitter.com)
# Valid OAuth Redirect URI: ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# 4. Telegram Bot API (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
